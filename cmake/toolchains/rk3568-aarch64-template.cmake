# Generic RK3568/aarch64 Linux cross-compilation template.
# A board-vendor SDK may require extra flags. Set at least RK3568_SYSROOT and
# optionally RK3568_CXX / RK3568_PREFIX_PATH before configuring.

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if(NOT DEFINED ENV{RK3568_SYSROOT} OR "$ENV{RK3568_SYSROOT}" STREQUAL "")
    message(FATAL_ERROR
        "RK3568_SYSROOT is required. Point it to the target root filesystem/sysroot.")
endif()

if(DEFINED ENV{RK3568_CXX} AND NOT "$ENV{RK3568_CXX}" STREQUAL "")
    set(CMAKE_CXX_COMPILER "$ENV{RK3568_CXX}" CACHE FILEPATH "" FORCE)
else()
    set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++ CACHE FILEPATH "" FORCE)
endif()

set(CMAKE_SYSROOT "$ENV{RK3568_SYSROOT}" CACHE PATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH "$ENV{RK3568_SYSROOT}")
if(DEFINED ENV{RK3568_PREFIX_PATH} AND NOT "$ENV{RK3568_PREFIX_PATH}" STREQUAL "")
    list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{RK3568_PREFIX_PATH}")
    set(CMAKE_PREFIX_PATH "$ENV{RK3568_PREFIX_PATH}" CACHE PATH "" FORCE)
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
